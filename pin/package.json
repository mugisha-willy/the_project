{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build-css && vite",
    "build": "npm run build-css && vite build",
    "build-css": "npx @tailwindcss/cli -i ./src/input.css -o ./src/output.css",
